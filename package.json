{
  "name": "tree-sitter-posix-awk",
  "version": "0.1.0",
  "private": true,
  "description": "Tree-sitter grammar for POSIX awk.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/konomanoasa/tree-sitter-posix-awk.git"
  },
  "type": "commonjs",
  "scripts": {
    "tree-sitter": "node scripts/tree-sitter.js",
    "generate": "npm run tree-sitter -- generate",
    "format": "biome check --write . && node scripts/check-scanner.js --write",
    "check:js": "biome check .",
    "check:generated": "node scripts/check-generated.js",
    "check:scanner": "node scripts/check-scanner.js",
    "test:corpus": "npm run tree-sitter -- test --rebuild",
    "test:wasm": "npm run tree-sitter -- test --wasm --rebuild",
    "test:parser": "node --test test/parser.test.js",
    "test": "npm run test:corpus && npm run test:wasm && npm run test:parser",
    "check": "npm run check:js && npm run check:scanner && npm run check:generated && npm test"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "tree-sitter-cli": "0.26.11",
    "web-tree-sitter": "0.26.11"
  },
  "allowScripts": {
    "tree-sitter-cli": true
  }
}
