{
  "name": "tree-sitter-posix-awk",
  "version": "0.1.0",
  "private": true,
  "description": "Tree-sitter grammar for POSIX awk.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/konomanoasa/tree-sitter-posix-awk.git"
  },
  "type": "commonjs",
  "scripts": {
    "check": "npm run check:generated && npm run check:parser-budget && npm run check:shellcheck && npm run check:biome && npm run check:clangd && npm run check:scanner-state && npm test && npm run test:wasm && npm run test:fuzz && npm run check:cst-fields && npm run check:runtime",
    "check:biome": "biome check .",
    "check:clangd": "clangd --check=src/scanner.c --tweaks= && clangd --check=test/scanner_state.c --tweaks=",
    "check:cst-fields": "scripts/check-cst-fields.sh",
    "check:generated": "scripts/check-generated.sh",
    "check:parser-budget": "scripts/check-parser-budget.sh",
    "check:runtime": "scripts/check-runtime.sh",
    "check:scanner-state": "scripts/check-scanner-state.sh",
    "check:shellcheck": "shellcheck scripts/*.sh",
    "format": "biome check --write . && shfmt -w scripts/*.sh && clang-format -i src/scanner.c test/scanner_state.c",
    "generate": "tree-sitter generate",
    "test": "tree-sitter test",
    "test:fuzz": "TREE_SITTER_SEED=1 tree-sitter fuzz --iterations 10 --edits 5",
    "test:wasm": "tree-sitter test --wasm"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "tree-sitter-cli": "0.26.11"
  },
  "allowScripts": {
    "tree-sitter-cli": true
  }
}
